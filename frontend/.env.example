# Frontend Environment Variables Example
# Copy this file to .env for local development
# For production, set these values in Vercel environment variables

# Backend API Configuration
# For local development: http://192.168.1.137:8000 (or http://localhost:8000)
# For production (Vercel): https://mestore.onrender.com
VITE_API_URL=http://192.168.1.137:8000
VITE_API_BASE_URL=http://192.168.1.137:8000

# Google OAuth Configuration
# Get your client ID from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Logging Configuration
# Set to true in production to enable remote logging
VITE_LOG_REMOTE=false
VITE_LOG_ENDPOINT=/api/logs

# Application Environment
# Options: development, staging, production
VITE_APP_ENV=development
