# Backend API Configuration
BACKEND_URL=https://mestore.onrender.com
FRONTEND_URL=http://localhost:3001

# Railway API (para logs en tiempo real)
# Obtener en: https://railway.app/account/tokens
RAILWAY_API_TOKEN=your_railway_api_token_here
RAILWAY_PROJECT_ID=your_project_id_here
RAILWAY_SERVICE_ID=your_service_id_here

# Database Configuration (PostgreSQL en Railway/Render)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis Configuration (para monitoreo de cache)
REDIS_URL=redis://host:6379

# Webhook Notifications (opcional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Monitoring Configuration
REFRESH_INTERVAL=5000
ALERT_ERROR_THRESHOLD=5
ALERT_RESPONSE_TIME_THRESHOLD=2000

# Node Environment
NODE_ENV=development
