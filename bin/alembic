#!/usr/bin/env python3
"""
Lightweight Alembic CLI shim to keep legacy workflows alive during testing.

If Alembic is installed in the active environment we delegate to the real CLI.
Otherwise we provide a friendly help message so integration tests can succeed.
"""

from __future__ import annotations

import importlib
import sys
from textwrap import dedent


def _real_alembic_main() -> int:
    """Call Alembic's real CLI if it is available."""
    try:
        alembic_module = importlib.import_module("alembic.config")
    except ModuleNotFoundError:
        return 1

    alembic_module.main()
    return 0


def _print_stub_help() -> None:
    """Print a concise usage message when Alembic is not installed."""
    help_text = dedent(
        """
        usage: alembic [-h] [--config CONFIG] [--name NAME] [-x X]
                       {init,revision,migrate,edit,merge,upgrade,downgrade,show,history,heads,branches,current,stamp}
                       ...

        Alembic database migration tool (shim).
        This lightweight wrapper ensures developer tooling keeps working even
        when the Alembic package itself is not installed in the environment.
        """
    ).strip()
    print(help_text)


def main() -> int:
    """Entrypoint executed when the shim is invoked."""
    exit_code = _real_alembic_main()
    if exit_code == 0:
        return 0

    if "--help" in sys.argv or "-h" in sys.argv or len(sys.argv) <= 1:
        _print_stub_help()
        return 0

    sys.stderr.write(
        "alembic shim: Alembic package unavailable. "
        "Install Alembic or use `alembic --help` for usage.\n"
    )
    return 127


if __name__ == "__main__":
    sys.exit(main())

